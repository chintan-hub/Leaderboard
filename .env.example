# Supabase Postgres — Transaction pooler (port 6543), used by the running app.
# connection_limit=1 keeps each serverless invocation to a single logical
# connection through the pooler (PgBouncer already pools underneath) so
# concurrent requests/prefetches don't multiply real connections.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10"
# Supabase Postgres — Session pooler (port 5432), used only for Prisma migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-a-random-64-char-hex-string"
