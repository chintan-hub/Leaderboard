// DentoCrafts Team Points & Recognition System — data model
//
// Core idea: every point-changing event (a +1 recognition or -1
// accountability deduction, always with a reason and category) is one
// immutable row in ScoreTransaction. Nothing else stores a running total —
// every employee's points are derived by summing this ledger, so "why does
// this employee have 6 points" is always answerable by listing their
// transactions. See src/lib/scoring/score.ts for the authoritative
// calculation.
//
// This was originally a production-scoring leaderboard (completed/returned
// case counts). That concept has been removed from the app; the
// PRODUCTION_COMPLETED/PRODUCTION_REWORK transaction types and their
// production-only columns (cases, responsibility) remain below purely so
// old historical rows keep loading — see the comments on each for details.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// The single Admin account (see src/lib/auth). Modeled as a table rather
// than an env-var credential so the auth layer can be swapped for
// multi-account auth later without a schema change.
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  transactions ScoreTransaction[]
}

// Departments are configurable, not hard-coded.
//
// scoringRule, rankingMetric, productionTrackingEnabled and
// reworkTrackingEnabled are LEGACY columns from the old production-scoring
// system (removed — the app is now a points-only Team Points & Recognition
// System). They are kept as-is, unused, rather than dropped in a migration:
// dropping them isn't necessary for anything the app does today, and
// leaving them costs nothing while keeping the migration history simple and
// reversible. No code reads or writes them anymore.
model Department {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  scoringRule   String   @default("NET_PRODUCTION")
  rankingMetric String   @default("AVG_NET_PER_EMPLOYEE")
  productionTrackingEnabled Boolean @default(true)
  reworkTrackingEnabled     Boolean @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  employees    Employee[]
  transactions ScoreTransaction[]
}

model Employee {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  transactions ScoreTransaction[]

  @@index([departmentId])
}

// PRODUCTION_COMPLETED and PRODUCTION_REWORK are LEGACY types from the old
// production-scoring system (removed — see the Department comment above).
// They are kept in the enum, unused by any code that creates new rows,
// solely so existing historical rows of these types keep loading correctly
// wherever the full ledger is read (e.g. Activity History).
enum TransactionType {
  PRODUCTION_COMPLETED
  PRODUCTION_REWORK
  MANUAL_BONUS
  MANUAL_DEDUCTION
  // A signed adjustment correcting a mistake in an earlier transaction.
  // Never edits or removes the original — see correctsTransactionId below.
  CORRECTION
}

// Only meaningful for PRODUCTION_REWORK (a returned case). Determines
// whether the return actually deducts from the score — e.g. a
// doctor-requested change is logged for transparency but must NOT penalize
// the employee.
enum ReworkResponsibility {
  DEPARTMENT_FAULT
  EXTERNAL_NOT_FAULT
}

// Only meaningful for type CORRECTION. Identifies which underlying counter
// the correction's signed delta (stored in `points`) adjusts — derived
// automatically from the transaction being corrected, never chosen freely.
enum CorrectionTarget {
  COMPLETED_CASES
  CASES_RETURNED
  CASES_RETURNED_EXTERNAL
  MANUAL_BONUS
  MANUAL_DEDUCTION
}

// The append-only ledger. Every score-changing action is one row here.
// Rows are never edited or deleted from the UI — a mistake is fixed by
// adding a new correcting transaction that references the original via
// correctsTransactionId, keeping full history intact.
model ScoreTransaction {
  id     String @id @default(cuid())
  type   TransactionType

  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Case count for PRODUCTION_* rows (always a positive integer; sign is
  // determined by `type`, not stored). 1 case = 1 unit regardless of how
  // many teeth it contains — teeth are never counted here. Null for
  // MANUAL_* rows.
  cases Int?

  // Signed point delta for MANUAL_* rows: +1 or -1. Null for PRODUCTION_* rows.
  points Int?

  // Required only for PRODUCTION_REWORK (legacy).
  responsibility ReworkResponsibility?

  // Only set for type CORRECTION — see CorrectionTarget above. `points`
  // carries the signed delta in this case (may be negative).
  correctionTarget CorrectionTarget?

  // Structured reason category for MANUAL_BONUS/MANUAL_DEDUCTION point
  // events — e.g. "DOCTOR_PRAISE", "LATE_MARK". Keys resolved against
  // src/lib/scoring/point-categories.ts, the same "string key resolved in
  // code" pattern Department.scoringRule already used, so new categories
  // can be added without a migration. Null for legacy PRODUCTION_* rows and
  // for CORRECTION rows, neither of which carry a category of their own.
  category String?

  // Always required — no unexplained score changes.
  reason String

  // The calendar date the event happened on. This drives monthly bucketing
  // (Monthly Results, employee point history), independent of when it was
  // entered. A correction reuses the ORIGINAL transaction's eventDate so it
  // retroactively fixes the correct month, even if entered later.
  eventDate DateTime

  createdAt DateTime @default(now())

  createdByAdminId String
  createdByAdmin   Admin  @relation(fields: [createdByAdminId], references: [id])

  // Self-relation for corrections: a new transaction can point back at the
  // one it corrects. The original row is left untouched.
  correctsTransactionId String?           @unique
  correctsTransaction   ScoreTransaction? @relation("Correction", fields: [correctsTransactionId], references: [id])
  correctedBy           ScoreTransaction? @relation("Correction")

  // Idempotency key stamped on a created row. If a submission is
  // retried/double-clicked with the same key, the action detects the
  // existing row and skips re-creating it instead of silently duplicating
  // the point event.
  batchId String?

  @@index([employeeId])
  @@index([departmentId])
  @@index([eventDate])
  @@index([batchId])
}
